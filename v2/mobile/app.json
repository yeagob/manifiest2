{
  "expo": {
    "name": "Manifiest",
    "slug": "manifiest-companion",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.manifiest.companion",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Manifiest lee únicamente tu total de pasos diario para sumarlo a las causas que apoyas. Nunca lee tu ubicación ni otros datos de salud.",
        "UIBackgroundModes": ["fetch", "processing"]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      }
    },
    "android": {
      "package": "app.manifiest.companion",
      "permissions": ["android.permission.health.READ_STEPS"]
    },
    "plugins": [
      "expo-secure-store",
      "expo-background-task",
      ["react-native-health", { "isClinicalDataEnabled": false }],
      "expo-health-connect",
      ["expo-build-properties", { "android": { "minSdkVersion": 26, "compileSdkVersion": 35, "targetSdkVersion": 35 } }]
    ]
  }
}
